			Accessories: {
				DOG: {
					Tooltip:
						'''
						增加30%点击伤害
						增加50%点击范围
						减少20%点击效果所需要的点击次数
						按下'切换饰品功能'键切换自动连点模式
						启用自动连点模式将略微降低手动点击的最大效率
						按下'切换瞄准辅助'键切换自动瞄准，自动锁定附近的敌人
						如果锁定的敌人死亡或消失，将搜索并锁定下一个敌人
						'游戏破环者'
						'''
					DisplayName: D.o.G
				}

				FingerOfBloodGod: {
					Tooltip:
						'''
						脱战后的第一次点击将触发点击效果
						在未进入冷却时间时额外触发一次点击效果
						触发后进入10秒的冷却
						'''
					DisplayName: 血神手指
				}

				BeetleClickingGlove: {
					DisplayName: 甲虫点击手套
					Tooltip:
						'''
						{$Mods.ClickerClass.Items.RegalClickingGlove.Tooltip}
						低于20%生命时增加25%点击伤害
						施加伤害减益基于你的点击速率
						'''
				}

				BloodyChocCookies: {
					DisplayName: 血腥巧克力饼干
					Tooltip:
						'''
						装备后，曲奇会定期在您的点击范围内生成
						点击曲奇能够增加你的点击伤害与范围的同时加快生命恢复速度
						血腥曲奇有概率替换普通曲奇
						点击血腥曲奇增加点击伤害和暴击并提高怒气槽增长速度
						根据每秒点击次数最高增加15%点击伤害
						每15次点击释放出大量能造成伤害的多种巧克力
						辛辣巧克力能造成更高的伤害并施加[c/F5334D:硫磺火]减益
						白巧克力在小范围内追踪玩家并回复4点生命值
						'''
				}

				SSMedal: {
					DisplayName: SS奖牌
					Tooltip:
						'''
						装备后，多个赋能圈将围绕着你转
						将光标保持在外侧赋能圈内对各级勋章充能
						分别获得最多10次必定暴击、点击范围提升、点击效果次数减少
						将光标保持在内侧赋能圈同时充能所有勋章
						全部勋章充能完毕，右键点击内测赋能圈，将释放能量并消耗所有充能
						'''
				}

				LihzahrdParticleAccelerator: {
					DisplayName: 蜥蜴粒子加速器
					Tooltip:
						'''
						在点击范围内靠近自身50%区域点击造成额外10点伤害
						增加5%点击暴击率
						点击暴击有20%概率造成3倍伤害
						'''
				}

				LunarClickingGlove: {
					DisplayName: 月神点击手套
					Tooltip:
						'''
						{$Mods.ClickerClass.Items.RegalClickingGlove.Tooltip}
						在点击范围内靠近自身50%区域点击造成额外25点伤害
						增加10%点击暴击率
						点击暴击有20%概率造成3倍伤害
						'''
				}

				CosmicClickingGlove: {
					DisplayName: 寰宇点击手套
					Tooltip:
						'''
						{$Mods.ClickerClass.Items.RegalClickingGlove.Tooltip}
						在点击范围内靠近自身50%区域点击造成额外100点伤害
						增加15%点击暴击率
						点击暴击有20%概率造成3倍伤害
						{$Mods.CalamityClickers.Items.Accessories.FingerOfBloodGod.Tooltip}
						'''
				}
			}

