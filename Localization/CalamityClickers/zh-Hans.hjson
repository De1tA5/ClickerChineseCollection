Mods: {
	CalamityClickers: {
		ClickEffect: {
			#Pre-Hardmode
			BasicAutoclicker: {
				Name: 基础自动连点
				Description: 每7.5秒自动点击（右键单击进行切换）
			}

			Sandstorm: {
				Name: 沙尘暴
				Description: 造成沙爆
			}

			SeaBubble: {
				Name: 海泡
				Description: 生成一个向上缓慢飘浮造成伤害的泡泡
			}

			Mushy: {
				Name: 菌生
				Description: 获得2秒的[c/34A8EB:与菇共生]效果
			}

			SulphurousBubbles: {
				Name: 硫海泡
				Description: 生成4-5个泡泡，点击泡泡造成范围伤害并施加[c/008000:辐射]减益
			}

			BloodyExplosion: {
				Name: 血液爆裂
				Description: 造成血液爆破，并施加[c/DE041A:血液沸腾]减益
			}

			BrainExplosion: {
				Name: 腐脑爆裂
				Description: 造成腐烂爆破，并施加[c/006400:大脑溃烂]减益
			}

			FeatherRain: {
				Name: 羽之雨
				Description: 召唤会爆炸的羽毛从天而降到光标处
			}

			ReelIn: {
				Name: 拉线
				Description: 召唤点击鱼，杀死他增加点击伤害25%，持续10秒（bug还没修）
			}

			SlimePuppet: {
				Name: 凝胶傀儡
				Description: 生成一个凝胶球，它会在短时间内向光标处冲刺
			}

			# Hardmode
			GaussFlux: {
				Name: 高斯脉冲
				Description: 制造磁力湍流
			}

			BrimstoneInferno: {
				Name: 硫火地狱
				Description: 造成五芒星爆破，并施加[c/F5334D:硫磺火]减益
			}

			CryoBomb: {
				Name: 极地爆弹
				Description: 在光标处召唤一个冷冻炸弹，点击该炸弹可以释放碎片
			}

			DaedalusCrystals: {
				Name: 代达罗斯水晶
				Description: 召唤会追踪敌人的代达罗斯光束
			}

			Crunch: {
				Name: 碎甲
				Description: 对最近的敌人施加3秒的[c/828D94:碎甲]减益
			}

			ChaosFlame: {
				Name: 混沌之火
				Description: 创造一个小型火焰传送门，并施加[c/F5334D:硫磺火]减益
			}

			#Post-Plantera
			TerraAura: {
				Name: 泰拉光环
				Description: 创造一个持续3秒的泰拉光环
			}

			GreenInfection: {
				Name: 绿色瘟疫
				Description: 发射 {0} 道燃烧的绿色灵液射弹
			}

			AnahitasVoice: {
				Name: 阿娜希塔之声
				Description: 生成一个音符圈
			}

			CoolFlake: {
				Name: 雪花
				Description: 召唤一个停留在原地的雪花，只能存在一个，再次触发点击效果则会延长存在时间
			}

			AureusBlast: {
				Name: 白金波动
				Description: 向光标处附近的每个敌人发射白金冲击波,对单个目标有不同效果
			}

			StellarScythe: {
				Name: 星幻飞镰
				Description: 生成一个向你的光标方向加速的星幻飞镰
			}

			# Post-Golem
			PlagueBees: {
				Name: 瘟疫蜜蜂
				Description: 召唤大量的瘟疫蜜蜂，瘟疫蜜蜂会施加[c/228B22:瘟疫]减益
			}

			Eruption: {
				Name: 喷发
				Description: 光标处生成持续伤害的爆炸领域
			}

			StarRain: {
				Name: 星之雨
				Description: 召唤4颗幻星到光标处
			}

			Stardust: {
				Name: 星尘
				Description: 在光标处释放星尘
			}

			Entropy: {
				Name: 熵能
				Description: 在光标处产生一个巨大的冥思能量爆炸
			}

			BloodBlasts: {
				Name: 血液爆炸
				Description: 生成8个射向光标的血液射弹
			}

			TaurusFang: {
				Name: 狂鲨獠牙
				Description: 生成13只旱海狂鲨之牙追踪并撕裂敌人
			}

			# Post-Moonlord
			# Early Stage
			
			ElementalAura: {
				Name: 元素光环
				Description: 创造一个持续2秒的元素光环，并施加持续1秒的[c/FFFA8C:元][c/F112FE:素][c/00B2F5:谐][c/00CC92:鸣]减益
			}

			PlagueBees2: {
				Name: "{$Mods.CalamityClickers.ClickEffect.PlagueBees.Name}"
				Description: "{$Mods.CalamityClickers.ClickEffect.PlagueBees.Description}"
			}

			RedLightning: {
				Name: 赤红闪电
				Description: 召唤4道从天而降的闪电
			}

			#Post-Providence
			ProfanedInferno: {
				Name: 亵渎炼狱
				Description: 造成神圣之火爆破，并施加持续3秒的[c/FCD200:神圣之火]减益
			}

			TarragonThorns: {
				Name: 龙蒿荆棘
				Description: 在光标处产生向8个方向长出荆棘
			}

			Judgement: {
				Name: 审判
				Description: 从天而降的神圣死亡射线将惩戒你的敌人
			}

			NovaSlimer: {
				Name: 星凝
				Description: 召唤追踪敌人的新星史莱姆
			}

			# Post-Polterghast
			GhastlyPortal: {
				Name: 惊魂之门
				Description: 召唤惊魂之门，每次点击都会从惊魂之门释放追踪幽魂
			}

			StratusMoon: {
				Name: 幻云月
				Description: 召唤7个新月，停留一段时间后朝光标处冲刺
			}

			Lifestealing: {
				Name: 生命窃取
				Description: 每点击一次回复2点生命
			}

			BloodyKnives: {
				Name: 血炎飞刀
				Description: 生成8把刀，在击中时卡住，施加[c/DE041A:血液沸腾]和[c/B216D9:死亡标记]减益
			}

			PhantasmalReach: {
				Name: 幻魂之触
				Description: 根据光标与玩家的距离改变伤害（在玩家位置为0.75倍，在屏幕角落为1.75倍）
			}

			# Post-DoG
			NebulaStars: {
				Name: 星云恒星
				Description: 召唤一圈小星云并在一会追踪敌人
			}

			Distort: {
				Name: 扭曲
				Description: 光标处扭曲时空，召唤出一群飞刀，它们会对你的点击做出反应
			}

			NightmareMagic: {
				Name: 梦魇魔法
				Description: 随机造成一项点击效果
			}

			Totality2: {
				Name: 日全食
				Description: 召唤一个微型日食，并对周围的敌人不断发射射弹
			}

			NuclearExplosion: {
				Name: 核爆
				Description: BOOM!
			}

			# Post-Yharon
			PhoenixWrath: {
				Name: 凤凰之怒
				Description: 召唤愤怒的凤凰，用火焰轰炸并施加[c/ff5500:龙炎]减益
			}

			MiceCatalyst: {
				Name: 催化鼠标
				Description: 召唤一个催化星云，生成向光标位置追踪的射弹
			}

			Popstar: {
				Name: 流星
				Description: 从天坠落欧米伽之星并在光标位置分裂3轮星星
			}

			# Pre-Endgame Bosses
			MiniExoTwins: {
				Name: 奥林匹斯的召唤
				Description: 召唤迷你阿尔忒弥斯和迷你阿波罗围绕光标攻击
			}

			Exomination: {
				Name: 星流迸发
				Description: 产生大范围的星流爆炸
			}

			LecherousOrb: {
				Name: 淫欲之眼
				Description: 消耗20生命生成淫欲之眼，点击可释放积累的生命能量
			}

			# Endgame
			ItzClick: {
				Name: Itz的点击
				Description: 对附近敌人施加巨额伤害的减益（百分比伤害）
			}

			Mischief: {
				Name: 恶作剧
				Description: 召唤一个迷你鼠标点击者，并触发在背包中离该武器最近的点击器的点击效果（恶作剧除外）
			}

			# Equip
			DaedalusLightning: {
				Name: 代达罗斯闪电
				Description: 从天空吸引代达罗斯的力量（创造闪电）
			}

			BurnOrBliss: {
				Name: 燃烧或极乐
				Description: 释放出大量能造成伤害的多种巧克力
			}

			# Draedon
			ScrapMissile: {
				Name: 废料导弹
				Description: 从天空向下发射一枚导弹，撞击目标时粉炸裂
			}

			DrillShot: {
				Name: 钻头发射
				Description: 射击一个能抓住敌人的钻头
			}

			Electrofield: {
				Name: 电磁感应
				Description: 召唤一个击中敌人会不断扩展的电磁场
			}

			VitalInfusion: {
				Name: 生命输液
				Description: 在玩家头顶生成注射器，每个注射右键回复25点生命
			}

			CurrentStrike: {
				Name: 电流打击
				Description: 发射强大的电离粒子流穿过敌人
			}
		}

		Items: {
			Armor: {
				Capsuit: {
					VictideCapsuit: {
						DisplayName: 胜潮连帽
						Tooltip: 增加5%点击伤害
						SetBonus:
							'''
							增加10%点击范围
							在液体中时获得+1.5生命恢复和10%点击伤害加成
							'''
					}

					AerospecCapsuit: {
						DisplayName: 天蓝连帽
						Tooltip:
							'''
							增加8%点击伤害
							增加15%点击范围
							'''
						SetBonus:
							'''
							一次性受到超过25点伤害会召唤追踪羽毛从天而降
							增加下落速度，免疫摔落伤害
							增加5%点击暴击率
							'''
					}

					StatigelCapsuit: {
						DisplayName: 斯塔提斯连帽
						Tooltip:
							'''
							增加10%点击伤害
							增加7%点击暴击率
							增加25%点击范围
							'''
						SetBonus:
							'''
							一次性受到超过100点伤害时，获得额外的无敌帧
							获得一段额外跳跃并增加跳跃高度
							增加12%跳跃速度
							'''
					}

					DaedalusCapsuit: {
						DisplayName: 代达罗斯连帽
						Tooltip:
							'''
							增加8%点击伤害
							增加7%点击暴击率
							增加25%点击范围
							'''
						SetBonus:
							'''
							点击器有[c/813F81A:达罗斯闪电]的效果
							增加5%点击伤害
							'''
					}

					HydrothermicCapsuit: {
						DisplayName: 渊泉连帽
						Tooltip:
							'''
							增加12%点击伤害
							增加10%点击暴击率
							增加25%点击范围
							'''
						SetBonus:
							'''
							生命值低于50%时获得狱火药水效果
							受伤时产生巨大爆炸
							增加5%点击伤害
							用点击器会施加[c/EB4E00:渊泉爆沸]减益
							[c/EB4E00:渊泉爆沸]是持续伤害减益具有50点基础伤害 
							使用点击器增加减益每秒5点伤害并延长1秒
							最高造成每秒500点伤害和20秒时间
							该减益效果类似
							'''
					}

					IntergelacticCapsuit: {
						DisplayName: 异宇星凝面盔
						Tooltip:
							'''
							增加15%点击伤害和暴击率
							增加30%点击范围
							'''
						SetBonus:
							'''
							在你周围召唤两个由小行星组成的星环，星环的伤害取决于你的伤害增幅
							按下'{$Mods.CatalystMod.Keybinds.ToggleVisibility}'使星环透明
							使用点击器使小行星飞离星环追踪敌人
							使用点击器武器从传送带上飞行小行星
							小行星可以随着时间的推移或使用点击器再生
							'''
					}

					TarragonCapsuit: {
						DisplayName: 龙蒿连帽
						Tooltip:
							'''
							增加10%点击伤害
							增加5%点击暴击率
							增加25%点击范围
							增加5%伤害减免
							'''
						SetBonus:
							'''
							增加红心拾取范围
							敌人死亡时有几率额外掉落红心
							用点击器攻击敌人增加1点防御和0.2%伤害减免，并使该增益延长1秒
							最高获得50点防御和20%伤害减免，持续20秒
							受到伤害重置该增益，获得10秒中冷却并放出龙蒿荆棘
							'''
					}

					BloodflareCrimeraCapsuit: {
						DisplayName: 血煞嵌合盔
						Tooltip:
							'''
							增加10%点击伤害和暴击率
							增加35%点击范围
							'''
						SetBonus:
							'''
							大幅增加生命再生，等同与猩红盔甲
							击中一个生命值低于50%的敌人会掉落红心
							这个效果有5秒冷却
							根据你当前的生命值减少对应触发点击效果所需要的点击次数
							最多减少20%
							使用点击器
							'''
					}

					GodSlayerCapsuit: {
						DisplayName: 弑神者连帽
						Tooltip:
							'''
							增加14%点击伤害和暴击率
							增加45%点击范围
							减少10%点击效果所需要的点击次数
							'''
						SetBonus:
							'''
							若每次攻击非暴击，点击暴击几率增加1%
							暴击后效果重置
							50次点击暴击，使用者获得[c/D75FF5:究极激发]使得之后每次点击造成暴击
							[c/D75FF5:究极激发]有30秒的冷却
							'''
					}

					AuricTeslaRadarCapsuit: {
						DisplayName: 金璇磁源盔
						Tooltip:
							'''
							增加30%点击伤害和暴击率
							增加100%点击范围
							减少10%点击效果所需要的点击次数
							'''
						SetBonus: 获得点击者龙蒿套装，血炎套装和弑神者套装的套装奖励
					}

					AuricTeslaPlusRadarCapsuit: {
						DisplayName: "{$Mods.CalamityClickers.Items.Armor.Capsuit.AuricTeslaRadarCapsuit.DisplayName}"
						Tooltip: "{$Mods.CalamityClickers.Items.Armor.Capsuit.AuricTeslaRadarCapsuit.Tooltip}"
						SetBonus:
							'''
							获得点击者异宇星凝套装，血炎套装和弑神者套装的套装奖励
							按下'{$Mods.CatalystMod.Keybinds.ToggleVisibility}'使星环透明
							'''
					}
				}

